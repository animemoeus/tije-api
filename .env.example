# Copy to .env and adjust. All settings are optional. Never commit .env (it is in .gitignore).

# --- Upstream login -------------------------------------------------------
# Leave both empty to log in as guest (enough for the map, buses and halte).
# Fill them to log in with your TransJakarta account (needed for /account/trips and other account endpoints).
# TJ_LOGIN_EMAIL=you@example.com
# TJ_LOGIN_PASSWORD=your-password
# Or use a token you already have (no login, no refresh):
# TJ_BEARER_TOKEN=

# --- Bus positions ---------------------------------------------------------
# Poll POST /v1/bus/offline for areas with a WebSocket client this often.
# TJ_POLL_SECONDS=0.5
# WS /ws?hz=1 gets one snapshot per this many seconds (hz=2: two, hz=4: four).
# TJ_WS_BASE_SECONDS=1
# Forget an area only asked for via GET /buses after this long.
# TJ_AREA_IDLE_SECONDS=60

# --- Misc -------------------------------------------------------------------
# Serve the map UI at /ui (off by default: API only, / opens /docs).
# TJ_SERVE_UI=true
# TJ_BASE_URL=https://tijeapi.transjakarta.co.id
# TJ_DEVICE_ID=0123456789abcdef
# TJ_LANG=id
# TJ_BUS_EXPIRY_SECONDS=300
# TJ_ROUTE_CACHE_SECONDS=3600
# TJ_DEFAULT_RADIUS_KM=1
# TJ_MAX_RADIUS_KM=5
